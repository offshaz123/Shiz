# Copy this file to .env.local for local development, or set these as
# environment variables in your Hostinger Node.js app settings for production.
# See README.md for full setup instructions.

# --- MySQL database (Hostinger hPanel > Databases > MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Admin panel login ---
# Generate a bcrypt hash with: npx bcrypt-cli "your-password-here"
# (or see the one-line Node script in README.md)
ADMIN_PASSWORD_HASH=
# Random 32+ character string used to sign admin login sessions.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# --- AI chat assistant (Anthropic Claude API) ---
ANTHROPIC_API_KEY=
# Optional — defaults to claude-opus-5 if not set.
CHAT_MODEL=claude-opus-5
