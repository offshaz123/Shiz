# Where order and contact emails are sent.
ORDERS_EMAIL=info@platedup.com

# SMTP account used to send those emails (Hostinger email: smtp.hostinger.com, port 465).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@platedup.com
SMTP_PASS=your-mailbox-password

# Optional: take card payments with Stripe Checkout. Leave blank to take orders
# without online payment (you then send the customer a payment link yourself).
STRIPE_SECRET_KEY=

# Public address of the site, used for Stripe's return links.
NEXT_PUBLIC_SITE_URL=https://platedup.co.uk
