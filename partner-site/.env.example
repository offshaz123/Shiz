# ---------------------------------------------------------------------------
# Environment variables for the OvaroPay site.
#
# Copy this file to .env.local for local development, and set the same keys
# in your host's control panel for the deployed site. Never commit a real
# .env file — .gitignore already excludes them; this example is the one
# exception, added deliberately so the key names live in the repo.
# ---------------------------------------------------------------------------

# --- The enquiry form (REQUIRED) -------------------------------------------
#
# Without all four of these the form returns a 500 and the visitor is told to
# email instead. The route checks them before it tries to connect, so a
# missing key fails cleanly rather than hanging.
#
# For a mailbox hosted on Hostinger (hPanel -> Emails), their documented
# settings are smtp.hostinger.com with SSL on port 465. If the connection is
# refused or the certificate is rejected, use port 587 instead, which is
# STARTTLS — the route switches automatically, because it only turns on
# implicit TLS when the port is exactly 465.
#
# SMTP_USER must be a real mailbox on the domain, not an alias, because it is
# also the From address and the password belongs to it.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@ovaropay.com
SMTP_PASS=

# --- Analytics (OPTIONAL) --------------------------------------------------
#
# Left empty on purpose. The cookie banner only loads analytics after a
# visitor accepts, and with no ID set it loads nothing at all, which is the
# current state. Put a measurement ID here when you are ready.
#
# NEXT_PUBLIC_ is a Next.js prefix meaning "safe to expose in the browser" —
# anything without it stays on the server. Never give the SMTP keys that
# prefix.

NEXT_PUBLIC_GA_ID=

# --- Accounts (REQUIRED for log in / sign up) ------------------------------
#
# AUTH_SECRET signs the session cookie. Generate one and keep it secret:
#
#     openssl rand -hex 32
#
# It must be at least 32 characters; the code refuses to run rather than fall
# back to a default, because a predictable key lets anyone mint a session for
# any account. Changing it logs everybody out, which is also how you force a
# logout everywhere if you ever need to.
#
# AUTH_DATA_DIR is where users.json is written. It needs a PERSISTENT disk —
# on a host with an ephemeral filesystem every deploy would wipe the accounts.
# Defaults to .data/ next to the app if unset.

AUTH_SECRET=
AUTH_DATA_DIR=
